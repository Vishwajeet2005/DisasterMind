# ──────────────────────────────────────────────────────────────
# DisasterMind — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Core LLM Engine (Required) ────────────────────────────────
# Get your key at https://console.groq.com/
GROQ_API_KEY=

# ── NASA FIRMS (Required for fire/hotspot detection) ──────────
# Register at https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_KEY=

# ── Google Earth Engine (Optional, enhances flood analysis) ───
# Set GEE_PROJECT to your GCP project ID.
# Set EE_CREDENTIALS_JSON to your service account JSON as a single-line string.
GEE_PROJECT=
EE_CREDENTIALS_JSON=

# ── Telegram Alerting (Optional, for emergency notifications) ─
# Create a bot via @BotFather and get the chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Infrastructure ─────────────────────────────────────────────
# Redis URL for distributed scan locking (prevents duplicate scans).
# On Render, this is auto-set when you add a Redis instance.
REDIS_URL=redis://localhost:6379/0

# ── Security: CORS Allowlist (Required in production) ─────────
# Comma-separated list of allowed frontend origins.
# Example: https://disastermind-ui.onrender.com
# In development: http://localhost:3000,http://localhost:5173
ALLOWED_ORIGINS=https://disaster-mind.vercel.app,http://localhost:3000
